# Backend Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Structured Database (PostgreSQL URL, falls back to local SQLite if omitted)
DATABASE_URL=sqlite:///./xpert_remnants.db

# Official Hindsight Python SDK Memory Engine
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=xpert-remnants-northstar

# LLM Provider Abstraction (groq, openai, or mock)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Retrieval context configuration
MAX_MEMORY_CONTEXT=4096
MAX_RETRIEVED_MEMORIES=8

# Synthetic Dataset Profile (DEV, DEMO, FULL, STRESS)
DATASET_PROFILE=DEV

# CORS
FRONTEND_URL=http://localhost:5173
